# Arquivo de referência. Copie para .env no ambiente local e preencha valores próprios.
# Nunca coloque senhas, chaves ou tokens reais neste arquivo versionado.

DJANGO_SECRET_KEY=replace-this-with-a-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Desenvolvimento local: SQLite.
DATABASE_URL=sqlite:///db.sqlite3

# Exemplo ilustrativo para PostgreSQL; não usar credenciais reais no repositório:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
